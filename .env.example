# Copy this file to .env and adjust values as needed.
# All variables are optional — sensible defaults are provided for local development.

# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=app/db/cv_analyzer.db

# Ollama API endpoint
OLLAMA_URL=http://localhost:11434/api/generate

# Ollama model to use for explainability (must be pulled first: ollama pull llama3)
OLLAMA_MODEL=llama3
